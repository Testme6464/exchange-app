# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signing secrets — NEVER commit these. The release keystore + passwords
# come from GitHub Secrets in CI (see README.md). The debug keystore IS
# committed on purpose (standard debug credentials, stable SHA-1).
android/app/release.keystore
android/key.properties
*.jks
*.keystore
!android/app/debug.keystore

# Binary build assets restored by CI (mirrors the health-assistant-apk
# repo): `flutter create` regenerates them, so they are not committed.
android/gradle/wrapper/gradle-wrapper.jar
android/gradlew
android/gradlew.bat
android/app/src/main/res/mipmap-*/ic_launcher.png
